# 이 파일은 "어떤 키가 필요한지" 보여주는 견본(템플릿)입니다.
# 실제 키 값은 절대 이 파일에 적지 않고, .env 파일에만 적습니다.
# .env 파일은 .gitignore에 의해 깃(Git)에 절대 올라가지 않도록 막혀 있습니다.

# 기업마당(bizinfo.go.kr) Open API 서비스키
BIZINFO_API_KEY=

# K-Startup(창업진흥원) 지원사업공고 Open API 서비스키 (공공데이터포털 발급, 실제 호출 검증 완료)
KSTARTUP_API_KEY=

# 한국콘텐츠진흥원(KOCCA) 지원사업공고 Open API 서비스키 (공공데이터포털 발급, 실제 호출 검증 완료)
KOCCA_API_KEY=

# 중소벤처기업진흥공단 Open API 서비스키 (kosmes.or.kr/opendata, 요청 명세 미확인 — 연동후보)
KOSMES_API_KEY=

# 정부24 공공서비스(혜택) API 서비스키 (data.go.kr/data/15113968, 자동승인)
PUBLIC_BENEFITS_API_KEY=

# (향후 추가) 공공데이터포털에서 발급받는 그 외 서비스키
# 공공데이터포털은 보통 "Encoding" 키와 "Decoding" 키 두 가지를 줍니다.
# 대부분의 경우 Decoding 키를 사용합니다. (docs/env-setup.md 참고)
# DATA_GO_KR_API_KEY=
