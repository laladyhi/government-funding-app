# 절대 커밋되면 안 되는 비밀 정보 (API 키 등)
.env
.env.local
.env.*.local
*.pem
*.key

# 로컬 전용 도구 설정 (개인 컴퓨터 경로 등이 들어있음 — 공개 저장소에 불필요)
.claude/settings.local.json

# 운영 DB 및 백업 (실제 수집 데이터 포함 — 코드만 공개하고 DB는 각자 로컬에서 생성)
app/data/*.sqlite3
app/data/*.sqlite3-*
app/data/backups/

# 실제 API에서 받아온 원본/가공 데이터 (민감정보는 아니지만, 실제 수집
# 시점의 데이터라 공개 저장소에는 올리지 않는다 — 코드만으로 재현 가능)
collector/raw/
collector/mapped/
collector/sample_response.json
collector/sample_kstartup_response.json
collector/sample_public_benefits_response.json
collector/sample_kocca_response.json
collector/fixtures/*_real_*.json

# 실행 중 자동 생성되는 오류 로그 (URL, 응답코드 등 운영 정보 포함)
collector/logs/*.jsonl
collector/logs/*.log
collector/logs/*.txt

# 실제 구동에 필요 없는 참고자료(발급 가이드, API 명세서 PDF/저장 웹페이지,
# 샘플 XML 등) — 전부 이 폴더 하나에 모아두고 통째로 무시한다.
# (저작권 있는 외부 기관 문서 재배포 방지 + 저장소를 코드 중심으로 유지)
/reference/

# PDF 도구가 페이지를 이미지로 렌더링하며 만든 임시 산출물(프로젝트 파일 아님)
/tmp/

# 나중에 Node.js 기반으로 개발 시작하면 자동으로 무시되어야 하는 것들
node_modules/
.next/
dist/
build/

# 나중에 Python 수집기 개발 시작하면 자동으로 무시되어야 하는 것들
__pycache__/
*.pyc
.venv/
venv/

# OS/에디터 관련
.DS_Store
Thumbs.db
